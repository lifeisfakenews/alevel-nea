---

export type Props = {
    title: string;
    icon: string;
    value: number;
    subtext?: string;
    subtext_type?: "default" | "success" | "error" | "warning";
}

const { title, icon, value, subtext, subtext_type = "default" } = Astro.props;

---

<div class="summary-stat | flex gap-100">
    <div>
        <h3>{title}</h3>
        <p class="value">{value.toLocaleString()}</p>
        <p class="subtext" data-summary-stat-subtext={subtext_type}>{subtext ?? ""}</p>
    </div>
    <div class="push-right">
        <div class="icon">
            <i class={"bx " + icon} aria-hidden="true"></i>
        </div>
    </div>
</div>

<style>
    .summary-stat {
        background: var(--nea-clr-dark-900);
        border: .1rem solid var(--nea-clr-dark-400);
        border-radius: .5rem;
        box-shadow: .5rem .5rem .5rem rgba(0, 0, 0, .2);
        padding: 1.5rem;

        h3 {
            font-size: 2rem;
            color: var(--nea-clr-text-100);
        }

        .value {
            font-family: var(--nea-ff-mono);
            font-size: 3.5rem;
            color: var(--nea-clr-primary-400);
        }

        .icon {
            background: var(--nea-clr-dark-800);
            border: .1rem solid var(--nea-clr-dark-700);
            border-radius: .5rem;
            padding: 1rem;
            height: 4rem;
            aspect-ratio: 1 / 1;

            i {
                font-size: 2rem;
                color: var(--nea-clr-text-100);
            }
        }
        
        .subtext {
            color: var(--nea-clr-text-100);

            &[data-summary-stat-subtext="success"] {
                color: var(--nea-clr-success-400);
            }
            &[data-summary-stat-subtext="error"] {
                color: var(--nea-clr-error-400);
            }
            &[data-summary-stat-subtext="warning"] {
                color: var(--nea-clr-warning-400);
            }
        }
    }
</style>